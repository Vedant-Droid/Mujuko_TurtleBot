<mujoco model="custom_diff_drive_robot">

    <compiler angle="radian" meshdir="models"/>

    <option timestep="0.005" gravity="0 0 -9.81"/>

    <asset>
        <!-- 270 mm diameter base plates -->
        <mesh name="base" file="Base.stl"
              scale="0.001 0.001 0.001"/>

        <!-- 83 mm diameter wheels (scaled from 98.05 mm raw STL -> 0.0008465 in X/Z) -->
        <mesh name="left_wheel" file="TireL.stl"
              scale="0.0008465 0.001 0.0008465"/>

        <mesh name="right_wheel" file="TireR.stl"
              scale="0.0008465 0.001 0.0008465"/>
    </asset>

    <worldbody>

        <light pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

        <geom name="ground"
              type="plane"
              size="2 2 0.1"
              rgba="0.3 0.3 0.3 1"/>

        <body name="robot" pos="0 0 0.0415">

            <!-- Bottom and top plates (270mm disc, rotated 90° so cutouts face Y-axis) -->
            <geom name="base_bottom_visual"
                  type="mesh"
                  mesh="base"
                  pos="0 0 0"
                  euler="0 0 1.5707963"
                  rgba="0.2 0.22 0.25 1"
                  contype="0"
                  conaffinity="0"/>

            <geom name="base_top_visual"
                  type="mesh"
                  mesh="base"
                  pos="0 0 0.045"
                  euler="0 0 1.5707963"
                  rgba="0.2 0.22 0.25 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Left Drive Wheel (83mm dia, 39mm wide, rolls along +X) -->
            <geom name="left_wheel_visual"
                  type="mesh"
                  mesh="left_wheel"
                  pos="0.00477 0.10857 0.01759"
                  euler="0 0 0"
                  rgba="0.12 0.12 0.12 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Right Drive Wheel (83mm dia, 39mm wide, rolls along +X) -->
            <geom name="right_wheel_visual"
                  type="mesh"
                  mesh="right_wheel"
                  pos="0.00477 -0.11143 -0.01759"
                  euler="0 0 0"
                  rgba="0.12 0.12 0.12 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Front Ball Caster (along +X forward axis, flush with 83mm wheels) -->
            <geom name="front_caster"
                  type="sphere"
                  pos="0.115 0 -0.0290"
                  size="0.0125"
                  rgba="0.75 0.15 0.15 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Rear Ball Caster (along -X rear axis, flush with 83mm wheels) -->
            <geom name="rear_caster"
                  type="sphere"
                  pos="-0.115 0 -0.0290"
                  size="0.0125"
                  rgba="0.75 0.15 0.15 1"
                  contype="0"
                  conaffinity="0"/>

        </body>

    </worldbody>

</mujoco>
